<?xml version="1.0" encoding="utf-8"?><androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#F7F8FA">

<!-- 顶部栏 -->
<LinearLayout
    android:id="@+id/topBar"
    android:layout_width="0dp"
    android:layout_height="68dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="12dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/brandText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="图转通"
            android:textColor="#15171A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="多格式图片转换 · 本地处理"
            android:textColor="#8A8F98"
            android:textSize="11sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/menuButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="更多"
        android:padding="10dp"
        android:src="@drawable/ic_more_vert"
        android:scaleType="centerInside" />

</LinearLayout>


<!-- 首页 -->
<ScrollView
    android:id="@+id/homePage"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp"
    android:scrollbars="none"
    android:background="#FFFFFF"
    app:layout_constraintTop_toBottomOf="@id/topBar"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 选择图片 -->
        <LinearLayout
            android:id="@+id/dropArea"
            android:layout_width="match_parent"
            android:layout_height="148dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_drop_area"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/selectImageIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="选择图片"
                android:padding="5dp"
                android:src="@drawable/ic_add_photo"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/selectImageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="选择图片"
                android:textColor="#15171A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="支持单张或批量选择 · 文件不会上传"
                android:textColor="#8A8F98"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- 待转换文件 -->
        <LinearLayout
            android:id="@+id/fileSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="待转换文件"
                    android:textColor="#15171A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fileCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 个"
                    android:textColor="#8A8F98"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/fileContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_file_list"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/fileList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>


        <!-- 输出格式 -->
        <LinearLayout
            android:id="@+id/outputFormatCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_setting_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输出格式"
                android:textColor="#15171A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/outputFormatDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="选择转换后的图片格式"
                android:textColor="#8A8F98"
                android:textSize="11sp" />

            <RadioGroup
                android:id="@+id/outputFormatGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/formatPng"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#15171A"
                    android:gravity="center_vertical"
                    android:text="PNG"
                    android:textColor="#15171A"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/formatJpeg"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#15171A"
                    android:gravity="center_vertical"
                    android:text="JPEG"
                    android:textColor="#15171A"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/formatWebp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#15171A"
                    android:gravity="center_vertical"
                    android:text="WebP"
                    android:textColor="#15171A"
                    android:textSize="13sp"
                    android:checked="true" />

            </RadioGroup>

        </LinearLayout>


        <!-- 输出设置 -->
        <LinearLayout
            android:id="@+id/webpSettingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_setting_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/outputSettingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WebP 设置"
                android:textColor="#15171A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/qualitySettingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="质量"
                    android:textColor="#15171A"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/qualityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85"
                    android:textColor="#15171A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <SeekBar
                android:id="@+id/qualitySeekBar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:max="90"
                android:progress="75" />

   <CheckBox
  android:id="@+id/transparentCheckBox"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:button="@drawable/bg_transparent_checkbox"
    android:buttonTint="@null"
    android:text="保留透明通道"
    android:textColor="#454A52"
    android:textSize="12sp"
    android:checked="true"
    android:gravity="center_vertical"
    android:paddingStart="6dp"
    android:minWidth="0dp"
    android:minHeight="0dp" />

        </LinearLayout>


        <!-- 输出目录 -->
        <LinearLayout
            android:id="@+id/outputDirectoryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_setting_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="13dp"
            android:paddingEnd="12dp"
            android:paddingBottom="13dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/outputDirectoryIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="输出目录"
                android:padding="4dp"
                android:src="@drawable/ic_folder"
                android:scaleType="centerInside" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输出目录"
                    android:textColor="#15171A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

           <TextView
    android:id="@+id/outputDirectoryText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:singleLine="true"
    android:scrollHorizontally="true"
    android:text="未选择，转换时设置"
    android:textColor="#8A8F98"
    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="选择目录"
                android:padding="5dp"
                android:src="@drawable/ic_arrow_forward"
                android:scaleType="centerInside" />

        </LinearLayout>


        <!-- 开始转换 -->
        <TextView
            android:id="@+id/convertButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="开始转换"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />


        <!-- 底部说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="全部图片在设备本地处理"
            android:textColor="#A0A4AA"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>


<!-- 转换页面 -->
<LinearLayout
    android:id="@+id/convertPage"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:visibility="gone"
    app:layout_constraintTop_toBottomOf="@id/topBar"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <ImageView
        android:id="@+id/convertingIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="120dp"
        android:contentDescription="正在转换"
        android:src="@drawable/ic_convert"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/convertingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="正在转换"
        android:textColor="#15171A"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/convertingSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="请稍候"
        android:textColor="#8A8F98"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/percentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:text="0%"
        android:textColor="#15171A"
        android:textSize="30sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="14dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/currentFileText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="middle"
        android:text="等待处理"
        android:textColor="#8A8F98"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/backgroundButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="后台运行"
        android:textColor="#555A62"
        android:textSize="12sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>


<!-- 结果页面 -->
<ScrollView
    android:id="@+id/resultPage"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    android:visibility="gone"
    android:scrollbars="none"
    app:layout_constraintTop_toBottomOf="@id/topBar"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <ImageView
            android:id="@+id/resultIcon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="50dp"
            android:contentDescription="转换完成"
            android:src="@drawable/ic_check_circle"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="15dp"
            android:text="转换完成"
            android:textColor="#15171A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/resultSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="资源瘦身成功"
            android:textColor="#8A8F98"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/savedSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:text="0 MB"
            android:textColor="#15171A"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/savedPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="节省 0%"
            android:textColor="#666B73"
            android:textSize="13sp" />


        <!-- 第一组统计：原始大小 / 输出大小 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <!-- 原始大小 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/originalSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 MB"
                    android:textColor="#15171A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/originalFormatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="原始文件"
                    android:textColor="#8A8F98"
                    android:textSize="11sp" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- 输出大小 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/webpSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 MB"
                    android:textColor="#15171A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/outputFormatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="输出文件"
                    android:textColor="#8A8F98"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- 第二组统计：成功 / 失败 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- 成功 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/successCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#15171A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="成功"
                    android:textColor="#8A8F98"
                    android:textSize="11sp" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- 失败 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/failedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#15171A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="失败"
                    android:textColor="#8A8F98"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- 每个文件的转换结果 -->
        <LinearLayout
            android:id="@+id/resultFileContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_file_list"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />


        <!-- 打开输出目录 -->
        <TextView
            android:id="@+id/openDirectoryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="打开输出目录"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />


        <!-- 继续转换 -->
        <TextView
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="继续转换"
            android:textColor="#555A62"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>