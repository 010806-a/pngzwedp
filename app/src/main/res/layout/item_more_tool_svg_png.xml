<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolSvgConverter"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_tool_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/toolIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="SVG 转换"
        android:padding="8dp"
        android:src="@drawable/ic_svg_to_png" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/toolTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SVG 转换"
            android:textColor="#292B2E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/toolSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="SVG → PNG / Android Vector XML"
            android:textColor="#85898E"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>