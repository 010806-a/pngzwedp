<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolDecompile"
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_tool_item"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_tool_icon_gray">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_decompile"
            android:contentDescription="SVG 转 XML" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SVG → XML"
            android:textColor="#292B2E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="将 SVG 转换为 Android Vector XML"
            android:textColor="#85898E"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_arrow_right"
        android:contentDescription="进入"
        android:alpha="0.55" />

</LinearLayout>