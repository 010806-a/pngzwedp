<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <!-- ==================== 顶部品牌栏 ==================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tool_icon_gray">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="P"
                android:textColor="#292B2E"
                android:textSize="19sp"
                android:textStyle="bold" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PNGZWEDP"
                android:textColor="#202226"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="图片格式转换工具"
                android:textColor="#8A8F98"
                android:textSize="10sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="返回"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>


    <!-- ==================== 页面滚动区域 ==================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="26dp"
            android:paddingBottom="32dp">

            <!-- ==================== 页面标题 ==================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SVG TOOLS"
                android:textColor="#85898E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="SVG 工具"
                android:textColor="#202226"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="批量将 SVG 转换为 Android Vector XML"
                android:textColor="#85898E"
                android:textSize="12sp" />


            <!-- ==================== 工作区 ==================== -->

            <LinearLayout
                android:id="@+id/workspace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">


                <!-- ================================================= -->
                <!-- SVG 文件 -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/fileCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_card">

                    <!-- 文件卡片标题 -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SVG 文件"
                                android:textColor="#292B2E"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/selectedFileHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="支持一次选择多个 SVG 文件"
                                android:textColor="#85898E"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/selectFileButton"
                            android:layout_width="82dp"
                            android:layout_height="38dp"
                            android:gravity="center"
                            android:text="选择文件"
                            android:textColor="#292B2E"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_tool_item"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>


                    <!-- ==================== Drop Zone ==================== -->

                    <LinearLayout
                        android:id="@+id/dropZone"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_drop_zone"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_tool_icon_gray">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="SVG"
                                android:textColor="#666B72"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="选择 SVG 文件"
                            android:textColor="#40444A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="支持批量选择 SVG 文件"
                            android:textColor="#969BA2"
                            android:textSize="10sp" />

                    </LinearLayout>


                    <!-- ==================== 文件列表标题 ==================== -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/selectedFileCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="尚未选择文件"
                            android:textColor="#292B2E"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/selectAllButton"
                            android:layout_width="58dp"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:text="全选"
                            android:textColor="#666B72"
                            android:textSize="11sp"
                            android:background="@drawable/bg_tool_item"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/clearFilesButton"
                            android:layout_width="58dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:text="清空"
                            android:textColor="#666B72"
                            android:textSize="11sp"
                            android:background="@drawable/bg_tool_item"
                            android:clickable="true"
                            android:focusable="true"
                            android:visibility="gone" />

                    </LinearLayout>


                    <!-- ==================== 动态文件列表 ==================== -->

                    <LinearLayout
                        android:id="@+id/fileListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="vertical"
                        android:background="#F7F8FA"
                        android:visibility="gone" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- XML 输出设置 -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/settingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XML 输出设置"
                        android:textColor="#292B2E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="以下设置应用于全部 SVG"
                        android:textColor="#85898E"
                        android:textSize="11sp" />


                    <!-- ==================== Vector 尺寸 ==================== -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="19dp"
                        android:text="Vector 尺寸"
                        android:textColor="#40444A"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:padding="3dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_tool_tab_container">

                        <TextView
                            android:id="@+id/originalVectorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="24dp"
                            android:textColor="#292B2E"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_tool_tab_selected"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/size48VectorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="48dp"
                            android:textColor="#666B72"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/customVectorButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="自定义"
                            android:textColor="#666B72"
                            android:textSize="11sp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/vectorSizeHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="默认使用 24dp Vector 尺寸"
                        android:textColor="#969BA2"
                        android:textSize="9sp" />


                    <!-- ==================== 文件名 ==================== -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="文件名"
                                android:textColor="#40444A"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="自动使用 SVG 原文件名生成 XML"
                                android:textColor="#969BA2"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/autoKeepOriginalNameCheckBox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="自动保留 SVG 原文件名"
                            android:textColor="#4D5259"
                            android:textSize="10sp"
                            app:useMaterialThemeColors="false" />

                    </LinearLayout>


                    <!-- ==================== 输出目录 ==================== -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="输出目录"
                        android:textColor="#40444A"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/directoryPath"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:ellipsize="start"
                                android:text="尚未设置输出目录"
                                android:textColor="#555A61"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/directoryHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="请选择 XML 保存位置"
                                android:textColor="#969BA2"
                                android:textSize="9sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/changeDirectoryButton"
                            android:layout_width="58dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:text="更改"
                            android:textColor="#292B2E"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_tool_item"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/openDirectoryButton"
                            android:layout_width="76dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:text="↗ 打开目录"
                            android:textColor="#666B72"
                            android:textSize="10sp"
                            android:background="@drawable/bg_tool_item"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>


                    <!-- ==================== 开始转换 ==================== -->

                    <TextView
                        android:id="@+id/convertButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="19dp"
                        android:gravity="center"
                        android:text="↓  开始批量转换"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_primary_button"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="每个 SVG 将生成对应的 Android Vector XML"
                        android:textColor="#969BA2"
                        android:textSize="9sp" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- 转换进度 -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/progressContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_card"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/progressText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="正在生成 XML"
                            android:textColor="#292B2E"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/progressCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 0"
                            android:textColor="#85898E"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="13dp"
                        android:max="100"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/progressCurrent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="当前："
                        android:textColor="#666B72"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/progressRemaining"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="剩余 0 个"
                        android:textColor="#85898E"
                        android:textSize="10sp" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- XML 转换结果 -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/resultContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:background="@drawable/bg_card"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/resultTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="转换结果"
                        android:textColor="#292B2E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/resultText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 个 SVG 已生成对应 XML"
                        android:textColor="#85898E"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/resultHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="所有文件已经处理完成"
                        android:textColor="#969BA2"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:id="@+id/resultListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/resultMoreText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="还有 33 个转换结果"
                        android:textColor="#85898E"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/resultOpenDirectoryButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="11dp"
                        android:gravity="center"
                        android:text="↗  打开输出目录"
                        android:textColor="#292B2E"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tool_item"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>


                <!-- ==================== 底部间距 ==================== -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>