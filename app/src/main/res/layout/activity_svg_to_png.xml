<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PNGZWEDP"
                    android:textColor="#292B2E"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="图片格式转换工具"
                    android:textColor="#8A8F98"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 页面主体 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- 页面标题 -->
            <LinearLayout
                android:id="@+id/pageHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="SVG TOOLS"
                    android:textColor="#858A92"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="SVG → PNG"
                    android:textColor="#292B2E"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="批量将 SVG 文件转换为 PNG 图片"
                    android:textColor="#777C84"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 工作区 -->
            <LinearLayout
                android:id="@+id/workspace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <!-- SVG 文件 -->
                <LinearLayout
                    android:id="@+id/fileCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SVG 文件"
                        android:textColor="#292B2E"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/selectedFileHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="选择需要转换的 SVG 文件"
                        android:textColor="#8A8F98"
                        android:textSize="13sp" />

                    <!-- 唯一文件选择入口 -->
                    <LinearLayout
                        android:id="@+id/dropZone"
                        android:layout_width="match_parent"
                        android:layout_height="156dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_drop_zone"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/addFileIcon"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_tool_icon_gray"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#292B2E"
                            android:textSize="28sp"
                            android:textStyle="normal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="添加 SVG 文件"
                            android:textColor="#292B2E"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="支持一次选择多个文件"
                            android:textColor="#92969D"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- 已选择文件 -->
                    <LinearLayout
                        android:id="@+id/selectedFilesHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/selectedFileCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="未选择文件"
                            android:textColor="#666B73"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/clearFilesButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_segment_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="清空"
                            android:textColor="#5F646C"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/fileListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                </LinearLayout>

                <!-- 输出设置 -->
                <LinearLayout
                    android:id="@+id/settingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="输出设置"
                        android:textColor="#292B2E"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- 输出尺寸 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="输出尺寸"
                        android:textColor="#555A62"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/sizeSegmentContainer"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/originalSizeButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="原尺寸"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/size1024Button"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="1024²"
                            android:textColor="#555A62"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/customSizeButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment_normal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="自定义"
                            android:textColor="#555A62"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/sizeHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="保持 SVG 原始尺寸"
                        android:textColor="#8A8F98"
                        android:textSize="12sp" />

                    <!-- 透明背景说明 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="#F7F8FA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="#E9EBEE"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="#555A62"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="PNG 默认保留 SVG 的透明背景"
                            android:textColor="#666B73"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- 输出目录 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="输出目录"
                        android:textColor="#555A62"
                        android:textSize="13sp"
                        android:textStyle="bold" />

          <!-- 输出目录功能卡片 -->
<LinearLayout
    android:id="@+id/directoryCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_drop_zone"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 目录信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tool_icon_gray"
            android:gravity="center"
            android:text="▣"
            android:textColor="#666B73"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/directoryPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="尚未设置输出目录"
                android:textColor="#292B2E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/directoryHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="转换后的 PNG 文件将保存到这里"
                android:textColor="#8A8F98"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 操作按钮：左右对称 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/changeDirectoryButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="选择"
            android:textColor="#555A62"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/openDirectoryButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="打开输出目录"
            android:textColor="#555A62"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>



                    </LinearLayout>

                    <!-- 主按钮 -->
                    <TextView
                        android:id="@+id/convertButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_primary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="开始转换"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="SVG → PNG · 支持批量转换"
                        android:textColor="#969AA1"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 转换进度 -->
            <LinearLayout
                android:id="@+id/progressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/progressText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="正在转换"
                        android:textColor="#292B2E"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/progressCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 0"
                        android:textColor="#858A92"
                        android:textSize="12sp" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progress="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/progressCurrent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#8A8F98"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/progressRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#8A8F98"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 转换结果 -->
            <LinearLayout
                android:id="@+id/resultContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_result_success"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/resultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="转换完成"
                    android:textColor="#315B40"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text=""
                    android:textColor="#557061"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/resultSuccessCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="成功 0"
                        android:textColor="#315B40"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/resultFailedCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="失败 0"
                        android:textColor="#8A5D5D"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/resultTotalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="共 0"
                        android:textColor="#557061"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/resultDirectoryPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="middle"
                    android:maxLines="2"
                    android:text=""
                    android:textColor="#557061"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>