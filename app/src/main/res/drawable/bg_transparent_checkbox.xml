<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 勾选状态 -->
    <item android:state_checked="true">

        <layer-list>

            <!-- 18dp × 18dp 的正方形 -->
            <item>
                <shape>

                    <size
                        android:width="18dp"
                        android:height="18dp" />

                    <corners
                        android:radius="3dp" />

                    <solid
                        android:color="#17191C" />

                </shape>
            </item>

            <!-- 小勾 -->
            <item
                android:width="10dp"
                android:height="10dp"
                android:gravity="center">

                <vector
                    android:width="10dp"
                    android:height="10dp"
                    android:viewportWidth="10"
                    android:viewportHeight="10">

                    <path
                        android:fillColor="#FFFFFF"
                        android:pathData="M1.2,5.1L2.2,4.1L4.15,6.05L7.8,2.4L8.8,3.4L4.15,8.05Z" />

                </vector>

            </item>

        </layer-list>

    </item>

    <!-- 未勾选状态 -->
    <item>

        <shape>

            <size
                android:width="18dp"
                android:height="18dp" />

            <corners
                android:radius="3dp" />

            <solid
                android:color="#FFFFFF" />

            <stroke
                android:width="1dp"
                android:color="#B8BDC4" />

        </shape>

    </item>

</selector>